{
  "info": {
    "name": "Biblioteca API - REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Autores",
      "item": [
        {
          "name": "Listar autores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores"
              ]
            }
          }
        },
        {
          "name": "Obter autor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autores/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores",
                "1"
              ]
            }
          }
        },
        {
          "name": "Criar autor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/autores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Lygia Fagundes Telles\",\n  \"nacionalidade\": \"Brasileira\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "Atualizar autor (ativar Orwell)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/autores/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores",
                "3"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"George Orwell\",\n  \"nacionalidade\": \"Britânica\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "Excluir autor sem livros",
          "request": {
            "method": "DELETE",
